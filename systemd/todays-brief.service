[Unit]
Description=Today's Brief — build the morning paper and deliver it to a phone

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/bin/bash @PROJECT_ROOT@/deliver.sh --quiet
Environment="PATH=@PYTHON_BIN@:/usr/local/bin:/usr/bin:/bin"
Environment=PYTHONUNBUFFERED=1
# This optional, private file supplies the model key and Telegram credentials.
EnvironmentFile=-%h/.config/todays-brief/env
# TCP readiness after resume is checked by deliver.sh.
TimeoutStartSec=3h
StandardOutput=journal
StandardError=journal
